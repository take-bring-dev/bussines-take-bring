{
  "name": "take-bring-business",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start --port 3001",
    "lint": "eslint",
    "assets": "node scripts/generate-brand-images.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed-admin.mjs",
    "stitch:generate": "node --env-file=.env scripts/stitch-generate.mjs",
    "stitch:sync": "node --env-file=.env scripts/stitch-sync-freight-direct.mjs"
  },
  "prisma": {
    "seed": "node scripts/seed-admin.mjs"
  },
  "allowScripts": {
    "@firebase/util": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "protobufjs": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "geist": "^1.8.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.30",
