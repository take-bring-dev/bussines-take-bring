// Take & Bring Business — Prisma schema
// Auth: custom JWT (NOT Supabase Auth)
// DB: Supabase Postgres via pooler

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  SHIPPER
  CARRIER_INDIVIDUAL
  CARRIER_COMPANY_ADMIN
  CARRIER_DRIVER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShipperAccountType {
  COMPANY
  INDIVIDUAL
}

enum VehicleClass {
  CAR
  VAN_3_5T
  TRUCK_7_5T
  TRUCK_12T
  TRUCK_24T
  TRUCK_40T
  OTHER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LoadStatus {
  DRAFT
  PUBLISHED
  RECEIVING_OFFERS
  OFFER_SELECTED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXPIRED
}

enum CargoType {
  PALLETS
  PACKAGES
  DOCUMENTS
  OTHER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicantType {
  INDIVIDUAL
  COMPANY
}

enum DocumentType {
  BUSINESS_REGISTRATION
  VAT_PROOF
  CARRIER_INSURANCE
  DRIVING_LICENCE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum EscrowStatus {
  AWAITING_PAYMENT
  AUTHORIZED
  CAPTURED
  CANCELLED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  name         String?
  phone        String?
  language     String     @default("de")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile              Profile?
  shipperProfile       ShipperProfile?
  carrierIndividual    CarrierIndividualProfile?
  carrierCompanyAdmin  CarrierCompanyProfile?    @relation("CompanyAdmin")
  driverProfile        Driver?
  sessions             AuthSession[]
  passwordResetTokens  PasswordResetToken[]
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  documents            Document[]
  loadsCreated         Load[]                    @relation("ShipperLoads")
  applications         LoadApplication[]
  escrowPayments       EscrowPayment[]           @relation("ShipperEscrow")
  auditLogs            AuditLog[]
  stripeCustomerId     String?                   @map("stripe_customer_id")
  locationLatest       DriverLocationLatest?
  locationPoints       DriverLocationPoint[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Profile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  kycStatus KycStatus @default(DRAFT)
  kycNote   String?   @map("kyc_note")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ShipperProfile {
  id              String             @id @default(cuid())
  userId          String             @unique @map("user_id")
  accountType     ShipperAccountType @map("account_type")
  companyName     String?            @map("company_name")
  legalForm       String?            @map("legal_form")
  vatId           String?            @map("vat_id")
  registrationNo  String?            @map("registration_no")
  billingStreet   String             @map("billing_street")
  billingZip      String             @map("billing_zip")
  billingCity     String             @map("billing_city")
  billingCountry  String             @default("DE") @map("billing_country")
  contactName     String             @map("contact_name")
  contactRole     String?            @map("contact_role")
  invoiceEmail    String             @map("invoice_email")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shipper_profiles")
}

model CarrierIndividualProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique @map("user_id")
  fullName           String       @map("full_name")
  addressStreet      String       @map("address_street")
  addressZip         String       @map("address_zip")
  addressCity        String       @map("address_city")
  addressCountry     String       @default("DE") @map("address_country")
  vatId              String?      @map("vat_id")
  vehicleClass       VehicleClass @map("vehicle_class")
  plateNumber        String       @map("plate_number")
  maxPayloadKg       Int          @map("max_payload_kg")
  cargoLengthCm      Int?         @map("cargo_length_cm")
  cargoWidthCm       Int?         @map("cargo_width_cm")
  cargoHeightCm      Int?         @map("cargo_height_cm")
  insuranceExpiry    DateTime?    @map("insurance_expiry")
  bankIban           String?      @map("bank_iban")
  bankAccountHolder  String?      @map("bank_account_holder")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carrier_individual_profiles")
}

model CarrierCompanyProfile {
  id                String   @id @default(cuid())
  adminUserId       String   @unique @map("admin_user_id")
  companyName       String   @map("company_name")
  legalForm         String?  @map("legal_form")
  vatId             String   @map("vat_id")
  addressStreet     String   @map("address_street")
  addressZip        String   @map("address_zip")
  addressCity       String   @map("address_city")
  addressCountry    String   @default("DE") @map("address_country")
  adminPhone        String?  @map("admin_phone")
  fleetSizeEstimate Int?     @map("fleet_size_estimate")
  insuranceExpiry   DateTime? @map("insurance_expiry")
  bankIban          String?  @map("bank_iban")
  bankAccountHolder String?  @map("bank_account_holder")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  admin    User      @relation("CompanyAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  drivers  Driver[]

  @@map("carrier_company_profiles")
}

model Vehicle {
  id              String        @id @default(cuid())
  companyId       String        @map("company_id")
  label           String
  vehicleClass    VehicleClass  @map("vehicle_class")
  plateNumber     String        @map("plate_number")
  payloadKg       Int           @map("payload_kg")
  volumeM3        Float?        @map("volume_m3")
  palletSpaces    Int?          @map("pallet_spaces")
  hasTailLift     Boolean       @default(false) @map("has_tail_lift")
  hasCurtainSide  Boolean       @default(false) @map("has_curtain_side")
  adrCapable      Boolean       @default(false) @map("adr_capable")
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company      CarrierCompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drivers      Driver[]
  applications LoadApplication[]

  @@unique([companyId, plateNumber])
  @@index([companyId])
  @@map("vehicles")
}

model Driver {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  userId          String?      @unique @map("user_id")
  fullName        String       @map("full_name")
  email           String?      @map("email")
  phone           String?
  licenceClass    String?      @map("licence_class")
  vehicleId       String?      @map("vehicle_id")
  status          DriverStatus @default(INVITED)
  trackingEnabled Boolean      @default(true) @map("tracking_enabled")
  /// Secret for Traccar Client / GPS Logger HTTP push (no cookies). Rotate anytime.
  ingestToken     String?      @unique @map("ingest_token")
  ingestTokenAt   DateTime?    @map("ingest_token_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  company      CarrierCompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  applications LoadApplication[]

  @@index([companyId])
  @@index([vehicleId])
  @@map("drivers")
}

/// Always-on latest position for a carrier user (driver or individual).
model DriverLocationLatest {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  lat        Float
  lng        Float
  accuracyM  Float?   @map("accuracy_m")
  speedMps   Float?   @map("speed_mps")
  headingDeg Float?   @map("heading_deg")
  altitudeM  Float?   @map("altitude_m")
  source     String   @default("foreground")
  recordedAt DateTime @map("recorded_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recordedAt])
  @@map("driver_location_latest")
}

/// Location history (sampled). Always-on — not limited to active loads.
model DriverLocationPoint {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  loadId     String?  @map("load_id")
  lat        Float
  lng        Float
  accuracyM  Float?   @map("accuracy_m")
  speedMps   Float?   @map("speed_mps")
  headingDeg Float?   @map("heading_deg")
  altitudeM  Float?   @map("altitude_m")
  source     String   @default("foreground")
  recordedAt DateTime @default(now()) @map("recorded_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  load Load? @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([loadId, recordedAt])
  @@map("driver_location_points")
}

model Load {
  id                   String       @id @default(cuid())
  shipperId            String       @map("shipper_id")
  reference            String?
  title                String?
  status               LoadStatus   @default(DRAFT)

  pickupCompany        String?      @map("pickup_company")
  pickupStreet         String       @map("pickup_street")
  pickupZip            String       @map("pickup_zip")
  pickupCity           String       @map("pickup_city")
  pickupCountry        String       @default("DE") @map("pickup_country")
  pickupContactName    String       @map("pickup_contact_name")
  pickupContactPhone   String       @map("pickup_contact_phone")
  pickupWindowStart    DateTime     @map("pickup_window_start")
  pickupWindowEnd      DateTime     @map("pickup_window_end")

  deliveryCompany      String?      @map("delivery_company")
  deliveryStreet       String       @map("delivery_street")
  deliveryZip          String       @map("delivery_zip")
  deliveryCity         String       @map("delivery_city")
  deliveryCountry      String       @default("DE") @map("delivery_country")
  deliveryContactName  String       @map("delivery_contact_name")
  deliveryContactPhone String       @map("delivery_contact_phone")
  deliveryWindowStart  DateTime     @map("delivery_window_start")
  deliveryWindowEnd    DateTime     @map("delivery_window_end")

  cargoDescription     String       @map("cargo_description")
  cargoType            CargoType    @default(OTHER) @map("cargo_type")
  quantity             Int          @default(1)
  weightKg             Int          @map("weight_kg")
  palletCount          Int?         @map("pallet_count")
  lengthCm             Int?         @map("length_cm")
  widthCm              Int?         @map("width_cm")
  heightCm             Int?         @map("height_cm")
  stackable            Boolean      @default(false)
  hazardous            Boolean      @default(false)
  requiredVehicleClass VehicleClass @map("required_vehicle_class")
  loadingHelpNeeded    Boolean      @default(false) @map("loading_help_needed")
  temperatureControl   Boolean      @default(false) @map("temperature_control")
  notes                String?
  suggestedBudgetEur   Decimal?     @map("suggested_budget_eur") @db.Decimal(12, 2)
  publishedAt          DateTime?    @map("published_at")
  assignedAt           DateTime?    @map("assigned_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  shipper        User                  @relation("ShipperLoads", fields: [shipperId], references: [id], onDelete: Cascade)
  applications   LoadApplication[]
  escrow         EscrowPayment?
  locationPoints DriverLocationPoint[]

  @@index([shipperId])
  @@index([status])
  @@index([publishedAt])
  @@map("loads")
}

model LoadApplication {
  id              String            @id @default(cuid())
  loadId          String            @map("load_id")
  applicantUserId String            @map("applicant_user_id")
  applicantType   ApplicantType     @map("applicant_type")
  companyId       String?           @map("company_id")
  proposedPrice   Decimal           @map("proposed_price") @db.Decimal(12, 2)
  currency        String            @default("EUR")
  message         String?
  vehicleId       String?           @map("vehicle_id")
  driverId        String?           @map("driver_id")
  status          ApplicationStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  applicant User     @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([loadId])
  @@index([applicantUserId])
  @@index([status])
  @@map("load_applications")
}

model EscrowPayment {
  id                    String       @id @default(cuid())
  loadId                String       @unique @map("load_id")
  applicationId         String       @map("application_id")
  shipperId             String       @map("shipper_id")
  carrierUserId         String       @map("carrier_user_id")
  amount                Decimal      @db.Decimal(12, 2)
  currency              String       @default("EUR")
  status                EscrowStatus @default(AWAITING_PAYMENT)
  stripePaymentIntentId String?      @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?    @map("stripe_checkout_session_id")
  stripeChargeId        String?      @map("stripe_charge_id")
  mock                  Boolean      @default(false)
  authorizedAt          DateTime?    @map("authorized_at")
  capturedAt            DateTime?    @map("captured_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  load    Load @relation(fields: [loadId], references: [id], onDelete: Cascade)
  shipper User @relation("ShipperEscrow", fields: [shipperId], references: [id], onDelete: Cascade)

  @@index([shipperId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@map("escrow_payments")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String?
  deviceType String?  @map("device_type")
  userAgent  String?  @map("user_agent")
  isActive   Boolean  @default(true) @map("is_active")
  lastSeen   DateTime @default(now()) @map("last_seen")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

model Document {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  type       DocumentType
  fileName   String         @map("file_name")
  storagePath String        @map("storage_path")
  mimeType   String?        @map("mime_type")
  sizeBytes  Int?           @map("size_bytes")
  expiresAt  DateTime?      @map("expires_at")
  status     DocumentStatus @default(PENDING)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
